# Port for the API server
PORT=5000
# Leave MONGO_URI empty to use the bundled local MongoDB (data stored in ./data/db).
# Or set it to your own MongoDB / MongoDB Atlas connection string.
MONGO_URI=
# Secret used to sign login tokens - change this
JWT_SECRET=change_this_secret_key
# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
